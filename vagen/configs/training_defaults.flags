# Shared defaults used by local and cluster training launchers.
#
# Keep experiment-specific settings (batch size, estimator, harness, rollout.n) and
# host-specific settings (GPU count and memory fraction) in each launcher. Callers append
# their own arguments after this file, so Hydra's last-value-wins rule still permits
# explicit overrides.
#
# `$V` is the VAGEN checkout; the caller defines it before reading this file.

data.max_prompt_length=1000
algorithm.kl_ctrl.kl_coef=0.0

actor_rollout_ref.model.use_remove_padding=True
actor_rollout_ref.model.use_fused_kernels=True
actor_rollout_ref.model.enable_gradient_checkpointing=True
actor_rollout_ref.actor.optim.lr=1e-6
actor_rollout_ref.actor.ppo_micro_batch_size_per_gpu=1
actor_rollout_ref.actor.use_kl_loss=False
actor_rollout_ref.actor.entropy_coeff=0.0
actor_rollout_ref.actor.fsdp_config.param_offload=True
actor_rollout_ref.actor.fsdp_config.optimizer_offload=True

actor_rollout_ref.rollout.log_prob_micro_batch_size_per_gpu=1
actor_rollout_ref.rollout.name=sglang
actor_rollout_ref.rollout.mode=async
actor_rollout_ref.rollout.multi_turn.enable=True
# The legacy separated trainer performs its first weight sync before putting SGLang to
# sleep. Disabling cache offload avoids an invalid resume-before-sleep transition.
actor_rollout_ref.rollout.free_cache_engine=False
actor_rollout_ref.rollout.skip_tokenizer_init=False

actor_rollout_ref.ref.log_prob_micro_batch_size_per_gpu=1
actor_rollout_ref.ref.fsdp_config.param_offload=True

# critic.enable stays experiment-specific: enabling it here would build and train a
# critic for GRPO as well as GAE.
critic.optim.lr=1e-5
critic.model.use_remove_padding=True
critic.model.enable_gradient_checkpointing=True
critic.ppo_micro_batch_size_per_gpu=1
critic.fsdp.param_offload=True
critic.fsdp.optimizer_offload=True

# Select VAGEN's multi-output agent loop instead of verl's default rollout path.
actor_rollout_ref.rollout.agent.agent_loop_config_path=$V/vagen/configs/agent_v2.yaml
+actor_rollout_ref.rollout.agent.agent_loop_manager_class=vagen.training.agent_loop.multi_output.MultiOutputAgentLoopManager
