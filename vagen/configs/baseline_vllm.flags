# The flags that make a VAGEN run work, shared by the local driver and the cluster
# entrypoint so the two cannot drift. Maintaining two copies cost two dead cluster jobs:
# each omission surfaces only on the cluster, one flag per submission.
#
# What belongs here: settings that make the run go at all, or that select VAGEN's own
# code path. What does not: anything an experiment varies (batch sizes, adv_estimator,
# harness, rollout.n) and anything host-shaped (gpu count, memory fraction).
# Both callers append their own after these, and hydra takes the last value.
#
# `$V` is the VAGEN checkout; the caller exports it before reading this file.

data.max_prompt_length=1000
algorithm.kl_ctrl.kl_coef=0.0

actor_rollout_ref.model.use_remove_padding=True
actor_rollout_ref.model.use_fused_kernels=True
actor_rollout_ref.model.enable_gradient_checkpointing=True
actor_rollout_ref.actor.optim.lr=1e-6
actor_rollout_ref.actor.ppo_micro_batch_size_per_gpu=1
actor_rollout_ref.actor.use_kl_loss=False
actor_rollout_ref.actor.entropy_coeff=0.0
actor_rollout_ref.actor.fsdp_config.param_offload=True
actor_rollout_ref.actor.fsdp_config.optimizer_offload=True

actor_rollout_ref.rollout.log_prob_micro_batch_size_per_gpu=1
actor_rollout_ref.rollout.name=vllm
actor_rollout_ref.rollout.mode=async
actor_rollout_ref.rollout.multi_turn.enable=True

actor_rollout_ref.ref.log_prob_micro_batch_size_per_gpu=1
actor_rollout_ref.ref.fsdp_config.param_offload=True

# critic.enable is NOT here on purpose: `need_critic` short-circuits on it, so setting it
# in the shared flags builds and trains a critic for the GRPO scripts too -- a whole extra
# model, and every critic/* metric measured against GRPO's whitened advantages. It is
# exactly the "anything an experiment varies" this file says it excludes. The PPO scripts
# set it themselves.
critic.optim.lr=1e-5
critic.model.use_remove_padding=True
critic.model.enable_gradient_checkpointing=True
critic.ppo_micro_batch_size_per_gpu=1
critic.fsdp.param_offload=True
critic.fsdp.optimizer_offload=True

# Selects VAGEN's agent loop. Without these verl runs its own, and the job comes up
# looking healthy while none of this repo's rollout code executes. The manager class
# takes a `+` because it is not materialised in the YAML schema.
actor_rollout_ref.rollout.agent.agent_loop_config_path=$V/vagen/configs/agent_v2.yaml
+actor_rollout_ref.rollout.agent.agent_loop_manager_class=vagen.training.agent_loop.multi_output.MultiOutputAgentLoopManager
